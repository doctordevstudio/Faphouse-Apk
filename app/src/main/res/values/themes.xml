<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FapHousePro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fh_bg</item>
        <item name="android:statusBarColor">@color/fh_bg</item>
        <item name="android:navigationBarColor">@color/fh_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/fh_gold</item>
    </style>

    <style name="Theme.FapHousePro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fh_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/fh_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.FapHousePro</item>
    </style>

    <style name="Theme.FapHousePro.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fh_black</item>
        <item name="android:statusBarColor">@color/fh_black</item>
        <item name="android:navigationBarColor">@color/fh_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>